{
  "name": "photolibrary",
  "productName": "PhotoLibrary",
  "version": "1.0.3",
  "private": true,
  "license": "MIT",
  "author": "hei",
  "type": "commonjs",
  "main": "backend/main.js",
  "scripts": {
    "dev:front": "vite",
    "dev:back": "electron .",
    "build": "vite build",
    "start": "run-p dev:front dev:back",
    "dist": "vite build && electron-builder",
    "dist:dir": "vite build && electron-builder --dir",
    "format": "prettier --write frontend backend"
  },
  "dependencies": {
    "archiver": "^7.0.0",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "npm-run-all": "^4.1.5",
    "prettier": "3.8.3",
    "vite": "^8.0.8",
    "vue": "^3.5.32"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "build": {
    "appId": "com.photolibrary.desktop",
    "productName": "PhotoLibrary",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/@img/**",
      "**/node_modules/sharp/**"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PhotoLibrary-Setup-${version}.${ext}",
      "icon": "../assets/build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "图片库"
    }
  }
}
